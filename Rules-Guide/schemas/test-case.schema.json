{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-setupkit/test-case.v2.schema.json",
  "title": "Test case",
  "type": "object",
  "required": [
    "id",
    "title",
    "area",
    "steps",
    "expected",
    "oracle",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TC-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "area": {
      "type": "string",
      "minLength": 2,
      "$comment": "product module / feature area, e.g. 'Subscription & Entitlement' — the grouping key: one band per area in the Sheet, one section per area in TEST_CASES.md. Band order comes from strategy.json modules[]. The strategy scope unit is NOT this field — it lives in traceability.strategyUnit"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected": {
      "type": "string",
      "minLength": 3
    },
    "oracle": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "spec",
            "golden-master",
            "differential",
            "invariant",
            "metamorphic",
            "consistency",
            "llm-judge",
            "human"
          ]
        },
        "source": {
          "type": "string",
          "$comment": "figma node-id, schema ref, baseline path, INV-N, rubric path"
        }
      },
      "additionalProperties": false
    },
    "priority": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "$comment": "execution priority of the CASE — mirrors the strategy depth bands: risk 7-9 -> High (deep), 4-6 -> Medium (standard), 1-3 -> Low (smoke). Not the same scale as bug.priority (P0-P3), which is a fix-order decision made by the bug owner"
    },
    "technique": {
      "enum": [
        "equivalence-partitioning",
        "boundary-value",
        "decision-table",
        "state-transition",
        "pairwise",
        "use-case",
        "error-guessing",
        "exploratory",
        "other"
      ]
    },
    "traceability": {
      "type": "object",
      "properties": {
        "requirement": {
          "type": "string"
        },
        "figmaNode": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "strategyUnit": {
          "type": "string"
        },
        "bug": {
          "type": "string",
          "pattern": "^BUG-[0-9]{3,}$",
          "$comment": "for regression cases: the fixed bug this case guards — the mechanical selector of the regression core"
        },
        "risk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      },
      "additionalProperties": false
    },
    "cadence": {
      "enum": [
        "every-round",
        "release-only"
      ],
      "$comment": "regression re-run cadence; default every-round; demotion to release-only is evidence-based (Regression-Testing kit)"
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "deprecated"
      ]
    }
  },
  "additionalProperties": false
}
